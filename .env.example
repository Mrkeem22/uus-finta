# Montonio (placeholder values)
MONTONIO_ENV=sandbox
MONTONIO_API_BASE=https://YOUR-MONTONIO-API-BASE
MONTONIO_ACCESS_KEY=
MONTONIO_SECRET_KEY=

# SMTP (Gmail App Password / või SendGrid/SMTP)
